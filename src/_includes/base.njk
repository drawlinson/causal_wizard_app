                </li>
              </ul>
            </li>

          </ul>
        </div>
      </div>
    </nav>
  </div>

  {{ content | safe }}

  {% if extraBodyScripts %}{% for src in extraBodyScripts %}
  <script type="module" src="{{ src }}"></script>
  {% endfor %}{% endif %}
</body>

</html>
