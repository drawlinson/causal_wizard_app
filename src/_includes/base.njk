<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta http-equiv="x-ua-compatible" content="ie=edge" />
  <title>{{ title or "Causal Wizard" }}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="author" content="AI/ML Services, Australia" />
  <meta name="description" content="
Explore cause and effect in historical data; predict the effects of counterfactual
scenarios and other interventions
using the latest Causal Inference methods and machine learning tools,
in an online web-app software.
Causal Wizard provides graphical causal software toosl for causal ML risk analysis, asset management,
product research, market research, user research, and industrial process optimization." />
  <meta name="keywords" content="Causal inference, Causal software, causal diagram, machine learning, causal ML, online, app, webapp, tool, statistics,
  case-control study, observational, natural experiment,
  maintenance, AI, user research, product design, asset management, customer relationship management, churn, uplift,
    A/B testing, risk assessment">

  <link rel="icon" href="/assets/images/favicons/favicon.ico" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Lato:400,700" type="text/css">

  <link rel="stylesheet" href="/assets/css/bootstrap.min.css" type="text/css" />
  <link rel="stylesheet" href="/assets/css/bootstrap-icons.css" type="text/css" />
  <link rel="stylesheet" href="/assets/css/driver.min.css" type="text/css" />
  <link rel="stylesheet" href="/assets/css/project.css" type="text/css" />
  {% if extraCss %}{% for href in extraCss %}
  <link rel="stylesheet" href="{{ href }}" type="text/css" />
  {% endfor %}{% endif %}

  <!-- TODO: add an analytics snippet here once you've picked a provider (no server-side settings anymore) -->

  <script src="/assets/js/jquery-3.6.0.min.js"></script>
  <script src="/assets/js/bootstrap.min.js"></script>
  <script src="/assets/js/driver.min.js"></script>
  {% if extraScripts %}{% for src in extraScripts %}
  <script src="{{ src }}"></script>
  {% endfor %}{% endif %}
</head>

<body>
