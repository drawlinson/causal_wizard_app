---
layout: base.njk
title: Study
extraScripts:
  - /assets/js/papaparse.min.js
  - /assets/js/xlsx.full.min.js
  - /assets/js/plotly-2.20.0.min.js
  - /assets/js/lodash.min.js
  - /assets/js/cytoscape.min.js
  - /assets/js/cytoscape-edgehandles.js
extraBodyScripts:
  - /assets/js/study-view.js
---
<div class="container">
<div class="card-body">

  <p><a href="/studies/">&larr; Your Studies</a></p>

  <div id="sv-loading" class="alert alert-info">Loading study&hellip;</div>
  <div id="sv-error" class="alert alert-danger" hidden></div>

  <div id="sv-content" hidden>
    <div class="d-flex flex-row bd-highlight mb-3 align-items-center gap-2 flex-wrap">
      <h2 class="mb-0 me-2" id="sv-name"></h2>
      <button class="btn btn-primary btn-sm" id="sv-check-button">Check</button>
      <span id="sv-check-status"></span>
      <a id="sv-dataset-link" href="#" target="_blank" class="btn btn-sm btn-outline-secondary ms-auto">Explore dataset &#8599;</a>
    </div>

    <div class="row mb-3">
      <div class="col-md-4">
        <label class="form-label" for="sv-method">Method</label>
        <select class="form-select" id="sv-method">
          <option value="cd+po">Causal Diagram &amp; Potential Outcomes</option>
          <option value="pd+fe">Panel Data with Fixed Effects</option>
        </select>
        <div class="form-text" id="sv-method-help"></div>
      </div>
      <div class="col-md-4">
        <label class="form-label" for="sv-treatment">Treatment</label>
        <select class="form-select" id="sv-treatment"></select>
        <select class="form-select form-select-sm mt-1 w-auto" id="sv-treatment-type"></select>
        <div>
          <button class="btn btn-sm btn-primary mt-1" type="button" data-bs-toggle="collapse" data-bs-target="#sv-treatment-collapse" id="sv-treatment-collapse-toggle" hidden>
            Treatment groups
          </button>
        </div>
      </div>
      <div class="col-md-4">
        <label class="form-label" for="sv-outcome">Outcome</label>
        <select class="form-select" id="sv-outcome"></select>
        <select class="form-select form-select-sm mt-1 w-auto" id="sv-outcome-type"></select>
      </div>
    </div>

    <div class="collapse mb-3" id="sv-treatment-collapse">
      <div class="card card-body">
        <div id="sv-treatment-widget"></div>
      </div>
    </div>

    <!-- Panel data fields -->
    <div id="sv-panel-fields" hidden>
      <h5>Panel data structure</h5>
      <div class="row mb-3">
        <div class="col-md-4">
          <label class="form-label" for="sv-panel-entity">Entity column <span class="text-muted fw-normal">(optional)</span></label>
          <select class="form-select" id="sv-panel-entity"></select>
          <div class="form-text">The column identifying each unit tracked over time (e.g. customer ID). Leave both this and Time unset for an ordinary regression, with no fixed effects.</div>
        </div>
        <div class="col-md-4">
          <label class="form-label" for="sv-panel-time">Time column <span class="text-muted fw-normal">(optional)</span></label>
          <select class="form-select" id="sv-panel-time"></select>
        </div>
        <div class="col-md-4">
          <label class="form-label" for="sv-panel-covariates">Covariates</label>
          <select class="form-select" id="sv-panel-covariates" multiple size="4"></select>
          <div>
            <button class="btn btn-sm btn-outline-secondary mt-1" type="button" id="sv-panel-covariates-clear">Clear</button>
          </div>
          <div class="form-text">Ctrl/Cmd-click to select multiple.</div>
        </div>
      </div>
    </div>

    <h5 class="mb-2 mt-4" id="sv-diagram-heading">Causal diagram</h5>

    <div id="sv-diagram-section">
      <p class="text-muted">
        Click empty space to add a node. Click a node to edit it. Switch to
        "Draw edges" and drag from one node to another to connect them; click
        an edge to delete it. See
        <a href="/articles/causal-diagram/" target="_blank">How to draw a causal diagram</a>.
      </p>
      <div class="btn-toolbar mb-2 gap-2" role="toolbar">
        <div class="btn-group" role="group">
          <input type="radio" class="btn-check" name="sv-graph-mode" id="sv-mode-nodes" checked>
          <label class="btn btn-outline-primary btn-sm" for="sv-mode-nodes">Edit nodes</label>
          <input type="radio" class="btn-check" name="sv-graph-mode" id="sv-mode-edges">
          <label class="btn btn-outline-primary btn-sm" for="sv-mode-edges">Draw edges</label>
        </div>
        <div class="btn-group" role="group">
          <button class="btn btn-outline-secondary btn-sm" id="sv-zoom-in">Zoom in</button>
          <button class="btn btn-outline-secondary btn-sm" id="sv-zoom-out">Zoom out</button>
          <button class="btn btn-outline-secondary btn-sm" id="sv-zoom-fit">Fit</button>
        </div>
        <button class="btn btn-outline-secondary btn-sm active" id="sv-legend-toggle" aria-pressed="true">Legend</button>
        <button class="btn btn-outline-danger btn-sm" id="sv-graph-clear">Clear diagram</button>
      </div>

      <div id="sv-legend" class="card card-body mb-2">
        <img src="/assets/images/graph-legend.png" alt="Diagram legend: numerical/categorical node icons, treatment (blue), outcome (green), unobserved (dashed), backdoor (orange-red fill), frontdoor (pale orange fill), instrumental variable (purple fill), collider (dark red outline only), mediator (grey fill, dark red outline)." style="max-width:100%;" />
      </div>

      <div id="sv-graph" style="width:100%; height:450px; border:1px solid #ccc;"></div>
    </div>

    <div class="card card-body mb-3 mt-4" id="sv-advanced-options">
      <h5>Advanced options</h5>
      <div class="row">
        <div class="col-md-4">
          <label class="form-label" for="sv-effect">Desired effect</label>
          <select class="form-select" id="sv-effect">
            <option value="ate">Average Treatment Effect (ATE)</option>
            <option value="att">Average Treatment Effect on the Treated (ATT)</option>
            <option value="atc">Average Treatment Effect on the Control (ATC)</option>
          </select>
          <div class="form-text">Panel data methods always calculate ATT, regardless of this setting.</div>
        </div>
        <div class="col-md-4">
          <label class="form-label" for="sv-split-test-pc">Held-out test set (%)</label>
          <input type="number" class="form-control" id="sv-split-test-pc" min="0" max="50" step="1">
          <div class="form-text">Percentage of rows randomly held back to validate model performance.</div>
        </div>
      </div>
    </div>

  </div>
</div>
</div>

<!-- Node add/edit modal -->
<div class="modal fade" id="node-modal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="node-modal-title">Add node</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label" for="node-modal-src">Variable</label>
          <select class="form-select" id="node-modal-src"></select>
        </div>
        <div class="mb-3">
          <label class="form-label" for="node-modal-name">Label</label>
          <input type="text" class="form-control" id="node-modal-name" />
        </div>
        <div class="mb-3">
          <label class="form-label" for="node-modal-type">Type</label>
          <select class="form-select" id="node-modal-type">
            <option value="numerical">Numerical</option>
            <option value="categorical">Categorical</option>
          </select>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-danger me-auto" id="node-modal-delete" hidden>Delete</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="node-modal-save">Save</button>
      </div>
    </div>
  </div>
</div>

<!-- Check results modal -->
<div class="modal fade" id="check-modal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog" style="max-width:85vw;">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Check results</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="check-modal-body"></div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>
